# ========================================================
# Vector DB (PostgreSQL pgvector) & RAG Backend Config
# ========================================================

# Google Gemini API Key (Required for LLM generation in /ask endpoint)
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL & pgvector Connection Details
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
PG_TABLE_NAME=document_chunks

# Ollama Local Embeddings Configuration
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
